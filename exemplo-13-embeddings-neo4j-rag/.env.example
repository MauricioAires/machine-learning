OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_SITE_KEY=your_site_key_here
OPENROUTER_SITE_NAME=your_site_name_here

# Models
NLP_MODEL=your_nlp_model_here

# Embeddings (using Transformers.js locally)
EMBEDDING_MODEL=your_embedding_model_here

# Neo4j
NEO4J_USER=your_neo4j_user_here
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_URI=your_neo4j_uri_here
NEO4J_DATABASE=your_neo4j_database_here

 # Vector search threshold
NEO4J_VECTOR_THRESHOLD=0.9